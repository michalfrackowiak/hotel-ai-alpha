# ---------------------------------------------------------------------------
# Hotel AI Alpha - environment template. Copy to .env and adjust.
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# SQLite file inside the container (mounted through ./data on the host)
DB_PATH=/app/data/db.sqlite3

# Initial superuser, created on first container start
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# Branding
HOTEL_NAME=Hotel Aurora
HOTEL_TAGLINE=Hotel Aurora · Jastrzębia Góra
HOTEL_CURRENCY=PLN
HOTEL_DEFAULT_LANGUAGE=pl
HOTEL_CONTACT_EMAIL=reception@hotel-aurora.example
HOTEL_CONTACT_PHONE=+48 58 000 00 00
HOTEL_ADDRESS=ul. Morska 1, 84-104 Jastrzębia Góra
# Public origin used in emailed booking links (no trailing slash)
HOTEL_PUBLIC_URL=http://localhost:8000

# Optional multi-currency display. Amounts are always stored in HOTEL_CURRENCY;
# these rates convert the displayed total (units of target per one unit of base).
# SUPPORTED_DISPLAY_CURRENCIES=PLN,EUR,USD,GBP
# EXCHANGE_RATES={"PLN": 1.0, "EUR": 0.23, "USD": 0.25, "GBP": 0.20}

# Seed demo data on boot (idempotent)
SEED_DEMO_DATA=true

# Hold cleanup interval for the compose scheduler sidecar (seconds)
HOLD_CLEANUP_INTERVAL_SECONDS=300

# ---------------------------------------------------------------------------
# Confirmation email. The console backend prints messages instead of sending.
# For real delivery set EMAIL_BACKEND=smtp and the SMTP settings below.
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=reception@hotel-aurora.example
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
BOOKING_EMAILS_ENABLED=true

# Transactional email provider: smtp (default), ses or postmark
EMAIL_PROVIDER=smtp
# EMAIL_WEBHOOK_SECRET=
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_REGION=eu-central-1
# POSTMARK_SERVER_TOKEN=

# Confirmation email retry policy. The scheduler retries failed sends with
# exponential backoff until they succeed or hit the attempt cap.
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_SECONDS=300
EMAIL_RETRY_MAX_SECONDS=21600

# ---------------------------------------------------------------------------
# Confirmation SMS. The console provider records messages in the log and is the
# offline default. Set SMS_PROVIDER=twilio plus the credentials for real texts.
# Set SMS_WEBHOOK_SECRET to verify inbound status and reply callbacks.
# Failed sends retry with exponential backoff until they succeed or hit the cap.
# ---------------------------------------------------------------------------
BOOKING_SMS_ENABLED=true
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_WEBHOOK_SECRET=
SMS_MAX_ATTEMPTS=5
SMS_RETRY_BASE_SECONDS=300
SMS_RETRY_MAX_SECONDS=21600

BOOKING_ACCESS_MAX_AGE_DAYS=180

# Guest account at /my-bookings/ (password, Google sign-in, and magic-link fallback).
# Magic links and email verification links are single use; cooldowns/throttles limit abuse.
GUEST_LOGIN_MAX_AGE_MINUTES=30
GUEST_LOGIN_COOLDOWN_SECONDS=300
GUEST_LOGIN_IP_COOLDOWN_SECONDS=60
GUEST_EMAIL_VERIFICATION_MAX_AGE_MINUTES=1440
GUEST_EMAIL_VERIFICATION_COOLDOWN_SECONDS=300
# Guest password login brute-force protection (sliding window counters).
GUEST_PASSWORD_LOGIN_WINDOW_SECONDS=900
GUEST_PASSWORD_LOGIN_MAX_ATTEMPTS_PER_EMAIL=10
GUEST_PASSWORD_LOGIN_MAX_ATTEMPTS_PER_IP=20
GUEST_BOOKING_LOOKUP_WINDOW_SECONDS=300
GUEST_BOOKING_LOOKUP_MAX_ATTEMPTS_PER_IP=15

# Cancellation policy: free until check-in minus this many days; later
# cancellations charge the first N stored nightly rates (capped at the total).
CANCELLATION_FREE_DAYS=3
CANCELLATION_FEE_NIGHTS=1

# Deposit/prepayment policy (pilot, hotel-level): none, percent, or fixed.
# PERCENT uses DEPOSIT_VALUE as a percentage of the booking total (e.g. 30).
# FIXED uses DEPOSIT_VALUE as an amount in the hotel currency (e.g. 200).
DEPOSIT_POLICY=none
DEPOSIT_VALUE=0

# ---------------------------------------------------------------------------
# Encryption for provider API keys at rest. Use a long random value in
# production. When empty, a key is derived from DJANGO_SECRET_KEY.
# To rotate: set FIELD_ENCRYPTION_KEY_OLD to the old value, set the new
# FIELD_ENCRYPTION_KEY, then run `manage.py rotate_provider_keys`.
# ---------------------------------------------------------------------------
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_OLD=

# Cache backend for throttling. The default database cache needs
# `manage.py createcachetable` (the Docker entrypoint does it on boot).
CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
CACHE_LOCATION=django_cache

# ---------------------------------------------------------------------------
# LLM providers. Providers can also be configured in the Django admin; values
# here are only used by the seed command for the initial records.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-latest

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Google Calendar (optional in the alpha). Path to a service-account JSON key
# or OAuth client secret file, mounted into the container.
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_CREDENTIALS_FILE=
GOOGLE_CALENDAR_ID=

# Google guest sign-in (optional). Create an OAuth 2.0 Web client in Google Cloud
# and add the redirect URI: ${HOTEL_PUBLIC_URL}/my-bookings/google/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Channel manager. OTA iCal feeds are imported into per-room blocks by the
# scheduler; a slow feed times out instead of stalling the loop.
# ---------------------------------------------------------------------------
CHANNEL_FEED_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# OpenLine self-hosted voice integration (optional). Connects to an existing
# OpenLine server; this app does not run OpenLine itself.
# WEBHOOK_SECRET must match the OpenLine server's WEBHOOK_SECRET (or its
# HTTP_GATEWAY_API_KEY if WEBHOOK_SECRET is not configured on the server).
# Webhook URL: ${HOTEL_PUBLIC_URL}/integrations/openline/webhook/
# ---------------------------------------------------------------------------
OPENLINE_URL=
OPENLINE_API_KEY=
OPENLINE_WEBHOOK_SECRET=
OPENLINE_TIMEOUT=15
OPENLINE_VERIFY_TLS=true
OPENLINE_ALLOW_UNSIGNED_WEBHOOKS=false
OPENLINE_DEFAULT_DEVICE_ID=
OPENLINE_DEFAULT_STREAM_URL=
OPENLINE_DEFAULT_STREAM_FORMAT=twilio
OPENLINE_INCOMING_STREAM_MODE=webhook_attach
OPENLINE_WEBHOOK_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Phone voice (OpenLine media bridge). Requires a public WSS endpoint that the
# OpenLine server can connect to. Disabled by default.
# ---------------------------------------------------------------------------
VOICE_PHONE_ENABLED=false
VOICE_PUBLIC_WSS_URL=
VOICE_STT_PROVIDER=openai
VOICE_TTS_PROVIDER=openai
VOICE_STT_MODEL=
VOICE_TTS_MODEL=
VOICE_TTS_VOICE=
VOICE_MAX_CONCURRENT_CALLS=2
VOICE_MAX_MINUTES_PER_DAY=120
VOICE_MAX_CALLS_PER_NUMBER_PER_HOUR=6
VOICE_PHONE_SILENCE_TIMEOUT_SECONDS=20
VOICE_PHONE_MAX_SECONDS=900
VOICE_ESTIMATED_COST_PER_MINUTE_USD=0
# Redact terminal PhoneCall PII after this many days (dry-run by default; legal review pending).
VOICE_PHONE_RETENTION_DAYS=30
REDIS_URL=redis://redis:6379/0
